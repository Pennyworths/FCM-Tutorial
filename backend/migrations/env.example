# Migration Environment Configuration
# Copy this file to .env and configure it

# =============================================================================
# AWS CONFIGURATION (Required)
# =============================================================================

# AWS Profile to use for authentication
# This should be the profile configured in ~/.aws/credentials
AWS_PROFILE=terraform

# AWS Region where your infrastructure is deployed
AWS_REGION=us-east-1

# Project name (must match the Project tag in AWS resources)
PROJECT_NAME=FCM

# Environment name (must match the Environment tag in AWS resources)
ENVIRONMENT=dev

