# ============================================================================
# Environment Variables for FCM Tutorial Deployment
# ============================================================================
# 
# Usage:
#   1. Copy this file to .env:
#      cp env.example .env
#   
#   2. Edit .env with your actual values (uncomment and fill in required fields)
#   
#   3. Deploy using:
#      make deploy-all
#      # or
#      ./scripts/deploy-infra.sh
#
# Core project configuration (required)
#DB_USERNAME=your_db_username
#DB_PASSWORD=your_db_password

# FCM_SERVICE_ACCOUNT_JSON_FILE=service-account.json
# AWS_REGION=us-east-1
# AWS_PROFILE=terraform
# AWS_PROJECT=FCM
# AWS_ENVIRONMENT=dev
